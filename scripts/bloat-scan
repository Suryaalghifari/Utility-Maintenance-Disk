#!/usr/bin/env bash
# bloat-scan — READ-ONLY adaptive storage-bloat classifier.
#   bloat-scan [MIN_MB]   large-file sweep threshold (default 200)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_lib.sh"
parse_flags "$@"
MIN_MB="${ARGS[0]:-200}"

report_bloat() {
  local p="$1" label="$2" action="$3" reason="$4" b tier
  [[ -e "$p" ]] || return 0
  b=$(path_bytes "$p"); (( b > 0 )) || return 0
  tier=$(adaptive_size "$b")
  printf '  %s [%-6s] %-10s %-24s %8s  %s  alasan: %s\n' \
    "$(size_dot "$b")" "$tier" "$action" "$label" "$(human "$b")" "$p" "$reason"
}

title "bloat-scan (read-only)"
info "Threshold adaptif: medium ≥300 MB · large ≥1 GB · huge ≥5 GB"
info "SAFE CLEAN=cache regenerable · PRUNE=review/native command · INSPECT=bukan junk"
hr
title "Adaptive bloat candidates"

# Safe caches with targeted cleaners/native commands.
report_bloat "$HOME/.npm/_cacache" "npm cache" "SAFE CLEAN" \
  "package cache regenerable; gunakan node-clean/npm cache clean"
report_bloat "$HOME/.npm/_npx" "npx execution cache" "PRUNE" \
  "sandbox paket npx regenerable; review versi lama sebelum hapus"
report_bloat "$HOME/snap/firefox/common/.cache" "Firefox Snap cache" "SAFE CLEAN" \
  "cache browser regenerable; gunakan firefox-clean setelah menutup Firefox"
report_bloat "$HOME/.cache/pip" "pip cache" "SAFE CLEAN" \
  "package cache regenerable; gunakan node-clean/pip cache purge"
report_bloat "$HOME/.gradle/caches" "Gradle caches" "PRUNE" \
  "dependency build regenerable; pakai cleanup Gradle bila tersedia"

# pnpm: command output owns active-store identity; other version stores need review.
active_pnpm=""
if command -v pnpm >/dev/null 2>&1; then
  active_pnpm=$(pnpm store path 2>/dev/null || true)
  [[ -n "$active_pnpm" ]] && active_pnpm=$(realpath -m "$active_pnpm")
fi
shopt -s nullglob
for store in "$HOME/.local/share/pnpm/store"/*; do
  [[ -d "$store" ]] || continue
  resolved=$(realpath -m "$store")
  if [[ -z "$active_pnpm" ]]; then
    report_bloat "$store" "pnpm store" "INSPECT" \
      "status store aktif tidak diketahui; pnpm store path tidak tersedia"
  elif [[ "$resolved" == "$active_pnpm" ]]; then
    report_bloat "$store" "pnpm active store" "INSPECT" \
      "store aktif menurut pnpm store path; jangan hapus"
  else
    report_bloat "$store" "pnpm legacy store" "PRUNE" \
      "bukan store aktif; review lalu gunakan pnpm store prune"
  fi
done
shopt -u nullglob

# Active tool/runtime data stays INSPECT regardless of size.
report_bloat "$HOME/.local/share/nvim" "Neovim data" "INSPECT" \
  "plugin/runtime Neovim aktif, bukan junk"
report_bloat "$HOME/.local/share/uv" "uv tool data" "INSPECT" \
  "runtime/tool uv aktif; gunakan command uv bila membersihkan cache"
report_bloat "$HOME/.ollama/models" "Ollama models" "INSPECT" \
  "model runtime lokal aktif, bukan junk"

# Project dependency artifacts regenerate, but may belong to active projects.
while IFS= read -r modules; do
  report_bloat "$modules" "project node_modules" "PRUNE" \
    "artifact dependency regenerable; pastikan proyek tidak aktif"
done < <(find "$HOME" -xdev -maxdepth 5 \
  \( -path "$HOME/.*" -o -path '*/.git' \) -prune -o \
  -type d -name node_modules -print -prune 2>/dev/null)

# Known model/download caches: expensive to recreate, so never SAFE CLEAN.
report_bloat "$HOME/.cache/huggingface" "HuggingFace cache" "PRUNE" \
  "model dapat diunduh ulang tetapi mahal bandwidth"
report_bloat "$HOME/.cache/torch" "Torch cache" "PRUNE" \
  "dependency dapat diunduh ulang; cek proyek aktif"
report_bloat "$HOME/.vscode/extensions" "VS Code extensions" "INSPECT" \
  "extension runtime aktif, bukan cache"

hr
title "Any file ≥ ${MIN_MB} MB (INSPECT only)"
found=0
while IFS=$'\t' read -r sz path; do
  [[ -n "$sz" ]] || continue; found=1
  printf '  %s [%-6s] %-10s %8s  %s  alasan: file besar tidak otomatis aman dihapus\n' \
    "$(size_dot "$sz")" "$(adaptive_size "$sz")" "INSPECT" "$(human "$sz")" "$path"
done < <(find "$HOME" -xdev -type f -size +"${MIN_MB}"M -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -20)
(( found )) || ok "No single file ≥ ${MIN_MB} MB."

hr
info "Scan read-only. Cleanup tetap lewat cleaner/native command dengan confirmation, --yes, dan --dry-run."
